<ui:FluentWindow x:Class="ExchangeFileValidator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ExchangeFileValidator.ViewModels"
        xmlns:views="clr-namespace:ExchangeFileValidator.Views"
        xmlns:controls="clr-namespace:ExchangeFileValidator.Controls"
        Title="Exchange File Validator" Height="780" Width="1240"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <controls:ActivePageToAppearanceConverter x:Key="ActiveAppearance" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PropertyCompareViewModel}">
            <views:PropertyCompareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReferenceBrowserViewModel}">
            <views:ReferenceBrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FrameViewModel}">
            <views:FrameView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExchangeFileViewModel}">
            <views:ExchangeFileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ValidationViewModel}">
            <views:ValidationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChecklistViewModel}">
            <views:ChecklistView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
            <views:ExportView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Exchange File Validator" />

        <!-- Global load bar -->
        <ui:Card Grid.Row="1" Padding="14" Margin="16,8,16,4">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Exchange File" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                    <ui:TextBox Grid.Column="1" Text="{Binding ExchangeFilePath}" IsReadOnly="True" Margin="0,0,4,0" PlaceholderText="demands…" />
                    <ui:Button Grid.Column="2" Content="…" Command="{Binding PickExchangeFileCommand}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="3" Text="Msg Set / PDU" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                    <ui:TextBox Grid.Column="4" Text="{Binding MsgSetPath}" IsReadOnly="True" Margin="0,0,4,0" PlaceholderText="Message List + Network Path + Dico…" />
                    <ui:Button Grid.Column="5" Content="…" Command="{Binding PickMsgSetCommand}" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="6" Text="ISR Applied" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                    <ui:TextBox Grid.Column="7" Text="{Binding IsrAppliedPath}" IsReadOnly="True" Margin="0,0,4,0" PlaceholderText="applied ISRs…" />
                    <ui:Button Grid.Column="8" Content="…" Command="{Binding PickIsrAppliedCommand}" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Architecture" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8" />
                    <ComboBox Width="150" ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture}" Margin="0,0,16,0" />
                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="Load" Appearance="Primary" Command="{Binding LoadCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left rail -->
            <Border Grid.Column="0" Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16">
                    <TextBlock Text="WORKSPACE" Opacity="0.45" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,6" />
                    <ui:Button Content="  Dashboard" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=Dashboard}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavDashboardCommand}"
                               Icon="{ui:SymbolIcon Home24}" />
                    <ui:Button Content="  Reference Data" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=Reference}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavReferenceCommand}"
                               IsEnabled="{Binding IsLoaded}" Icon="{ui:SymbolIcon Database24}" />
                    <ui:Button Content="  Explorer" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=Explorer}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavExplorerCommand}"
                               IsEnabled="{Binding IsLoaded}" Icon="{ui:SymbolIcon Layer24}" />
                    <ui:Button Content="  Frame Layout" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=FrameView}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavFrameViewCommand}"
                               IsEnabled="{Binding IsLoaded}" Icon="{ui:SymbolIcon Table24}" />
                    <TextBlock Text="VALIDATION" Opacity="0.45" FontSize="10" FontWeight="SemiBold" Margin="8,12,0,6" />
                    <ui:Button Content="  Exchange File" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=Exchange}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavExchangeCommand}"
                               IsEnabled="{Binding IsLoaded}" Icon="{ui:SymbolIcon Table24}" />
                    <ui:Button Content="  Validation" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=Validation}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavValidationCommand}"
                               IsEnabled="{Binding IsLoaded}" Icon="{ui:SymbolIcon CheckmarkCircle24}" />
                    <ui:Button Content="  Checklist" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=Checklist}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavChecklistCommand}"
                               IsEnabled="{Binding IsLoaded}" Icon="{ui:SymbolIcon Clipboard24}" />
                    <ui:Button Content="  ISR vs Message Set" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=IsrVsMsgSet}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavIsrVsMsgSetCommand}"
                               IsEnabled="{Binding IsLoaded}" Icon="{ui:SymbolIcon ArrowSwap24}" />
                    <ui:Button Content="  Other Requirements" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=OtherReq}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavOtherReqCommand}"
                               IsEnabled="{Binding IsLoaded}" Icon="{ui:SymbolIcon TextBulletListSquare24}" />
                    <ui:Button Content="  Export" Appearance="{Binding ActivePage, Converter={StaticResource ActiveAppearance}, ConverterParameter=Export}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding NavExportCommand}"
                               IsEnabled="{Binding IsLoaded}" Icon="{ui:SymbolIcon ArrowExport24}" />
                    <TextBlock Text="MORE" Opacity="0.45" FontSize="10" FontWeight="SemiBold" Margin="8,12,0,6" />
                    <ui:Button Content="  Light / Dark" Appearance="Transparent" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Margin="0,2" Command="{Binding ToggleThemeCommand}"
                               Icon="{ui:SymbolIcon DarkTheme24}" />

                    <Separator Margin="4,16" />
                    <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="8,0" />
                </StackPanel>
            </Border>

            <!-- Active page -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
