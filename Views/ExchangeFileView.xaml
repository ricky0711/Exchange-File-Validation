<UserControl x:Class="ExchangeFileValidator.Views.ExchangeFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ExchangeFileValidator.Views">
    <UserControl.Resources>
        <views:LevelToBrushConverter x:Key="LevelToBrush" />
        <views:WorstSeverityToRowBrushConverter x:Key="RowTint" />
        <views:MismatchTintConverter x:Key="MismatchTint" />
        <views:CrcStateToBrushConverter x:Key="CrcStateToBrush" />
        <views:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <views:NullToVisibleConverter x:Key="NullToVisible" />
        <views:TraceLayerToBrushConverter x:Key="TraceLayerToBrush" />
    </UserControl.Resources>

    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Action bar: level/fill re-run (merged from the old Level + Property Fill pages) -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="Re-run level + fill" Appearance="Primary"
                       Command="{Binding RerunCommand}" Margin="0,0,8,0" />
            <ui:Button Grid.Column="1" Content="Load 2nd Architecture (L2.1)"
                       Command="{Binding LoadSecondArchCommand}" Icon="{ui:SymbolIcon Layer24}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.6" FontSize="11"
                       Text="{Binding SecondArchName, StringFormat='2nd arch: {0}'}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Opacity="0.85" FontSize="12" TextTrimming="CharacterEllipsis"
                       Text="{Binding PipelineSummary}" />
        </Grid>

        <!-- Filter bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Summary}" VerticalAlignment="Center" Opacity="0.85" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" Margin="0,0,6,0" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding LevelFilters}" SelectedItem="{Binding SelectedLevel}" Margin="0,0,6,0" />

            <ToggleButton x:Name="ColumnsToggle" Grid.Column="3" Margin="0,0,6,0" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Table24" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="Columns" />
                </StackPanel>
            </ToggleButton>
            <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle, Mode=TwoWay}" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=ColumnsToggle}" Placement="Bottom"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,2,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                    </Border.Effect>
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ColumnChooser}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Margin="2,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>

            <ui:TextBox Grid.Column="4" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search all columns…" Icon="{ui:SymbolIcon Search24}" />
        </Grid>

        <DataGrid x:Name="Grid" Grid.Row="2"
                  ItemsSource="{Binding DemandsView}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  RowHeaderWidth="0" SelectionMode="Single" ColumnWidth="Auto"
                  SelectedItem="{Binding SelectedDemand}"
                  RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Resources>
                <!-- Custom cell template for the Level chip column (built programmatically) -->
                <DataTemplate x:Key="LevelChipCell">
                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                            Background="{Binding Level, Converter={StaticResource LevelToBrush}}">
                        <TextBlock Text="{Binding LevelLabel}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                </DataTemplate>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding WorstSeverity, Converter={StaticResource RowTint}}" />
                </Style>
            </DataGrid.RowStyle>

            <!-- Expandable per-ISR detail: ISR (online) vs AT (Message Set), CRC/CLK badges, findings, note -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16" Margin="2,4,2,10" Effect="{StaticResource SoftShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: side-by-side property comparison -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"
                                           Text="{Binding ParameterProposal, StringFormat='Signal: {0}'}" />

                                <!-- CRC / Clock badges -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                                            Background="{Binding Detail.CrcState, Converter={StaticResource CrcStateToBrush}}">
                                        <TextBlock Text="{Binding Detail.CrcBadge}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="8,3"
                                            Background="{Binding Detail.ClkState, Converter={StaticResource CrcStateToBrush}}">
                                        <TextBlock Text="{Binding Detail.ClkBadge}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </StackPanel>

                                <!-- Comparison table header -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PROPERTY" Opacity="0.5" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="ISR (ONLINE)" Opacity="0.5" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="AT (MESSAGE SET)" Opacity="0.5" FontSize="10" FontWeight="SemiBold" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Detail.Props}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Match, Converter={StaticResource MismatchTint}}"
                                                    CornerRadius="3" Padding="4,3" Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Property}" FontSize="12" Opacity="0.85" />
                                                    <TextBlock Grid.Column="1" Text="{Binding IsrValue}" FontSize="12" TextWrapping="Wrap" Margin="6,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding MsgSetValue}" FontSize="12" TextWrapping="Wrap" Margin="6,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- TRACE: signal → PDU → container → route (Part B) -->
                                <Separator Margin="0,12,0,8" />
                                <TextBlock Text="TRACE — signal → I-PDU → container → route" Opacity="0.5"
                                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Trace.Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="3" Padding="6,1" Height="18"
                                                        VerticalAlignment="Top" HorizontalAlignment="Left"
                                                        Background="{Binding Layer, Converter={StaticResource TraceLayerToBrush}}">
                                                    <TextBlock Text="{Binding Layer}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- RIGHT: findings + note for this ISR -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FINDINGS" Opacity="0.5" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="3" Padding="6,1" Height="18" VerticalAlignment="Top"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                                    <TextBlock Text="{Binding Rule}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Margin="6,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No findings — clean." FontSize="11" Opacity="0.5" Margin="0,2"
                                           Visibility="{Binding WorstSeverity, Converter={StaticResource NullToVisible}}" />

                                <Separator Margin="0,10" />
                                <TextBlock Text="NOTE (this ISR)" Opacity="0.5" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                            PlaceholderText="Add a note for this ISR…" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</UserControl>
