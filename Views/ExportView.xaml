<UserControl x:Class="ExchangeFileValidator.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="28,22,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Alliance Export Center" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Prepare and generate Pre-vision-compatible sheets or fill original macro-enabled workbooks." 
                       Opacity="0.75" FontSize="13" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Two Column Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Export configuration -->
            <ui:Card Grid.Column="0" Padding="28" Margin="0,0,24,0" VerticalAlignment="Top" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <TextBlock Text="Configuration Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18" />

                    <!-- Format chooser -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Target Format Specification" FontWeight="SemiBold" FontSize="12.5" Opacity="0.8" Margin="0,0,0,6" />
                        <ComboBox HorizontalAlignment="Left" Width="280" Height="38"
                                  ItemsSource="{Binding Formats}"
                                  SelectedItem="{Binding SelectedFormat}" />
                        <TextBlock Text="• '270' represents the full Pre-vision format layout.&#x0a;• '212' represents the reduced core fields layout.&#x0a;• 'Exchange File' fills the original workbook in-place."
                                   Opacity="0.55" FontSize="11" Margin="0,6,0,0" LineHeight="16" />
                    </StackPanel>

                    <!-- Filter checkbox -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,0,0,22">
                        <StackPanel>
                            <CheckBox Content="Export only rows marked 'Ready to import'"
                                      IsChecked="{Binding ReadyOnly}" 
                                      IsEnabled="{Binding IsReadyOnlyEnabled}" 
                                      FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock Text="When enabled, demands containing active blocking validation errors are omitted from the output."
                                       Opacity="0.55" FontSize="11" Margin="24,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Export button -->
                    <ui:Button Content="Export Alliance Data" 
                               Appearance="Primary" 
                               Command="{Binding ExportCommand}"
                               Icon="{ui:SymbolIcon ArrowExport24}" 
                               Height="40" Padding="20,0"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>

            <!-- RIGHT COLUMN: Stat overview / status card -->
            <StackPanel Grid.Column="1">
                <!-- Info Status Card -->
                <ui:Card Padding="24" Margin="0,0,0,16" Effect="{StaticResource SoftShadow}">
                    <StackPanel>
                        <TextBlock Text="Summary &amp; Target Statistics" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                        
                        <!-- Mini graphic icon container -->
                        <Border Height="80" CornerRadius="8" Background="#103D5AFE" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#203D5AFE">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="DocumentArrowRight24" Foreground="#3D5AFE" FontSize="36" Margin="20,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Target File Validation" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Exports are structurally validated for direct integration with PREEvision/Alliance systems." 
                                               Opacity="0.65" FontSize="11" TextWrapping="Wrap" LineHeight="15" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="STATUS DETAILS" FontSize="10" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,8" />
                        
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                                CornerRadius="8" Padding="16" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Summary}" FontSize="12.5" FontWeight="SemiBold" Opacity="0.9" TextWrapping="Wrap" LineHeight="18" />
                        </Border>
                        
                        <TextBlock Text="Ensure all mandatory checklists are signed off before final system deployment." 
                                   FontStyle="Italic" Opacity="0.5" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
