<UserControl x:Class="ExchangeFileValidator.Views.FrameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header strip -->
        <ui:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Layout.Header, FallbackValue='Frame layout'}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ui:TextBox Width="170" Text="{Binding FrameSearch, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Frame name…" Icon="{ui:SymbolIcon Search24}" Margin="0,0,6,0" />
                    <ui:Button Content="Open" Appearance="Primary" Command="{Binding SearchCommand}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Bit/byte matrix -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Effect="{StaticResource SoftShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid x:Name="Matrix" />
                </ScrollViewer>
            </Border>

            <!-- Side: legend + detail -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <ui:Card Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LEGEND" Opacity="0.5" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border Width="14" Height="14" CornerRadius="3" Background="#556D5DF5" />
                            <TextBlock Text="Application signal" Margin="8,0,0,0" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border Width="14" Height="14" CornerRadius="3" Background="#5500897B" />
                            <TextBlock Text="CRC (E2E)" Margin="8,0,0,0" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border Width="14" Height="14" CornerRadius="3" Background="#558E24AA" />
                            <TextBlock Text="Clock (E2E)" Margin="8,0,0,0" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border Width="14" Height="14" CornerRadius="3" Background="#33808080" />
                            <TextBlock Text="Padding (fixed to zero)" Margin="8,0,0,0" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="14">
                    <StackPanel>
                        <TextBlock Text="SIGNAL DETAIL" Opacity="0.5" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
